            {
              "name": "Protected",
              "item": [
                {
                  "name": "Reject Unauthenticated Requests",
                  "event": [
                    {
                      "listen": "test",
                      "script": {
                        "type": "text/javascript",
                        "exec": [
                          "pm.test(\"Status code is 400\", function () {\r\n    pm.response.to.have.status(400);\r\n});\r\n\r\npm.test(\"Rejected protected route request; 'Invalid JWT' message\", function () {\r\n    const jsonData = pm.response.json();\r\n    const error = jsonData.errors.filter((error) => error.message === \"Invalid JWT\")\r\n    pm.expect(error[0].message).to.eql(\"Invalid JWT\");\r\n});"
                        ]
                      }
                    }
                  ],
                  "request": {
                    "auth": {
                      "type": "bearer",
                      "bearer": [
                        {
                          "key": "token",
                          "value": "{{AUTH_TOKEN}}",
                          "type": "string"
                        }
                      ]
